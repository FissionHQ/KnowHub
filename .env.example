# ─── Database ─────────────────────────────────────────────────────────────────
# Required by docker-compose for the postgres service (must match DATABASE_URL user/db).
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
POSTGRES_DB=wiki
DATABASE_URL=postgresql://wiki:wiki@localhost:5434/wiki
DATABASE_URL_READER=postgresql://wiki:wiki@localhost:5434/wiki

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── S3 / LocalStack ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_QUARANTINE_BUCKET=wiki-quarantine
S3_SERVED_BUCKET=wiki-served

# ─── SQS / LocalStack ─────────────────────────────────────────────────────────
SQS_ENDPOINT=http://localhost:4566
SQS_PDF_QUEUE_URL=http://localhost:4566/000000000000/wiki-pdf-processing

# ─── Auth (email/password + HS256 JWT — same in dev and production) ───────────
# Use a strong random string (32+ chars). Keep secret and rotate periodically.
JWT_SECRET=dev-secret-change-in-production-32chars

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
COLLAB_PORT=3003
BASE_DOMAIN=localhost
# Public web URL for invite links (browser-facing). On the IP deploy use e.g.
# http://3.15.148.16:3000 — not localhost and not an internal docker hostname.
APP_URL=http://localhost:3000
# Auth cookie Secure flag. false for plain HTTP (e.g. http://IP:3000);
# true only when the app is served over HTTPS.
COOKIE_SECURE=false

# ─── Worker (ClamAV virus scan) ───────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ─── Web (Next.js — set before `next build` in production) ────────────────────
# Server-side rewrite targets (use internal service URLs in Docker/AWS).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Browser WebSocket URL for collaborative editing (use wss:// in production).
# Local Docker on your machine: ws://localhost:3003
# Remote dev server (app opened at http://YOUR_IP:3000): ws://YOUR_IP:3003
# Do NOT use localhost when accessing the app from another machine — Chrome blocks it.
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:3003
# Dev-only: bypass collab-token cookie flow. Do NOT set in production.
# NEXT_PUBLIC_DEV_JWT=

# ─── SES / Email (dev: use mailhog) ───────────────────────────────────────────
SES_ENDPOINT=http://localhost:1025
SES_FROM_ADDRESS=noreply@wiki.example.com

# ─── Production notes ─────────────────────────────────────────────────────────
# Omit S3_ENDPOINT, SQS_ENDPOINT, SES_ENDPOINT, and AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY when using IAM roles on ECS/EKS/EC2.
# Set BASE_DOMAIN to your real domain (e.g. knowhub.example.com).
# Run `pnpm db:migrate` once per deploy; do NOT run `pnpm db:seed` in production.
