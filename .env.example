# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://wiki:wiki@localhost:5434/wiki
DATABASE_URL_READER=postgresql://wiki:wiki@localhost:5434/wiki

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── S3 / LocalStack ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_QUARANTINE_BUCKET=wiki-quarantine
S3_SERVED_BUCKET=wiki-served

# ─── OpenSearch ───────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ─── SQS / LocalStack ─────────────────────────────────────────────────────────
SQS_ENDPOINT=http://localhost:4566
SQS_PDF_QUEUE_URL=http://localhost:4566/000000000000/wiki-pdf-processing
SQS_INDEX_QUEUE_URL=http://localhost:4566/000000000000/wiki-search-indexing

# ─── Auth (email/password + HS256 JWT — same in dev and production) ───────────
# Use a strong random string (32+ chars). Keep secret and rotate periodically.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
SEARCH_PORT=3002
BASE_DOMAIN=localhost
JWT_SECRET=dev-secret-change-in-production-32chars

# ─── SES / Email (dev: use mailhog) ───────────────────────────────────────────
SES_ENDPOINT=http://localhost:1025
SES_FROM_ADDRESS=noreply@wiki.example.com
