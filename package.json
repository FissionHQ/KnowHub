{
  "name": "wiki-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "postinstall": "turbo run build --filter=@wiki/types --filter=@wiki/config --filter=@wiki/db",
    "prepare": "pnpm --filter @wiki/types --filter @wiki/config --filter @wiki/db --filter @wiki/doc-collab build",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @wiki/db db:generate",
    "db:migrate": "pnpm --filter @wiki/db db:migrate",
    "db:seed": "pnpm --filter @wiki/db db:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "@types/express": "^4.17.25"
    }
  },
  "dependencies": {
    "pnpm": "^11.10.0"
  }
}
